{
  "name": "notecreep",
  "version": "0.1.0",
  "description": "Edge-docked Electron note-taking app with global hotkey, tabs, rich-text editor, and share-by-email / Gist cloud sync.",
  "main": "dist/main/index.js",
  "scripts": {
    "postinstall": "electron-builder install-app-deps",
    "dev": "concurrently -k \"npm run dev:renderer\" \"npm run dev:main\"",
    "dev:renderer": "vite",
    "dev:main": "tsc -p tsconfig.main.json --watch",
    "build": "npm run build:renderer && npm run build:main",
    "build:renderer": "vite build",
    "build:main": "tsc -p tsconfig.main.json",
    "start": "npm run build && electron .",
    "electron:dev": "concurrently -k \"npm run dev:renderer\" \"wait-on http://localhost:5173 && npm run build:main && cross-env NODE_ENV=development electron .\"",
    "smoke:storage": "tsc --module commonjs --esModuleInterop --target ES2020 --outDir dist-smoke src/main/storage/smoke-test.ts && node dist-smoke/main/storage/smoke-test.js",
    "dist": "npm run build && electron-builder"
  },
  "keywords": ["notes", "electron", "tray", "hotkey"],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^20.0.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.0",
    "concurrently": "^8.2.0",
    "electron": "^29.0.0",
    "electron-builder": "^24.9.0",
    "typescript": "^5.3.0",
    "vite": "^5.1.0",
    "wait-on": "^7.2.0",
    "cross-env": "^7.0.3"
  },
  "dependencies": {
    "@tiptap/core": "^2.1.0",
    "@tiptap/extension-underline": "^2.1.0",
    "@tiptap/react": "^2.1.0",
    "@tiptap/starter-kit": "^2.1.0",
    "better-sqlite3": "^11.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "build": {
    "appId": "com.notecreep.app",
    "productName": "NoteCreep",
    "files": ["dist/**/*", "assets/**/*", "package.json"],
    "directories": { "output": "release" },
    "mac": { "target": "dmg" },
    "win": { "target": "nsis" },
    "linux": { "target": "AppImage" }
  }
}
